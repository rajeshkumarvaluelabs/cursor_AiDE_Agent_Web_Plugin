graph TD
    %% ========================================
    %% EXTERNAL SYSTEMS & DATA LAYER
    %% ========================================
    subgraph External ["🌐 External Systems"]
        direction LR
        Liferay["☁️ Liferay/DI Platform"]
        Domo["📊 Domo Analytics"]
        EmailSystem["📧 Email System"]
    end

    subgraph DataLayer ["🗄️ Data Layer"]
        direction TB
        JobTitleTierApprovalsTable["📋 Job Title Tier<br/>Approvals Table"]
        CommerceHRUserDataTable["👤 Commerce HR<br/>User Data Table"]
        FacilitySalesCenterMappingsTable["🏢 Facility Sales Center<br/>Mappings Table"]
        CHREmailNotificationsTable["📬 Email Notifications<br/>Table"]
    end

    subgraph MessageQueues ["📨 Message Queues"]
        direction LR
        CommerceHRUserSalesOrgQueue["📤 User Sales Org<br/>Queue"]
        CommerceHRUserTierApprovalsQueue["📤 User Tier Approvals<br/>Queue"]
    end

    %% ========================================
    %% MAIN EVENT BUS
    %% ========================================
    EventBus(["🚌 EventBridge Bus<br/><i>Central Event Hub</i>"])

    %% ========================================
    %% MAIN STATE MACHINE WORKFLOW
    %% ========================================
    subgraph MainWorkflow ["🔄 CHR User Creation State Machine"]
        direction TB
        
        %% Entry Point
        Start([🚀 Start]) 
        EventRule{"📥 Event Received<br/><i>created-commerce-user</i>"}
        
        %% Job Title Lookup Phase
        subgraph JobTitlePhase ["1️⃣ Job Title Validation"]
            LookupJobTitle["🔍 Lookup Job Title<br/>& Approval Service"]
            JobTitleDecision{"📊 Job Title<br/>Record Exists?"}
            JobTitleError["❌ Job Title Not Found<br/>Notification Service"]
        end
        
        %% Facility Lookup Phase
        subgraph FacilityPhase ["2️⃣ Facility Validation"]
            LookupFacility["🏢 Lookup Facility<br/>Name Service"]
            FacilityDecision{"🏢 Facility Sales<br/>Center Exists?"}
            FacilityError["❌ Facility Not Found<br/>Notification Service"]
        end
        
        %% Account Creation Phase
        subgraph AccountPhase ["3️⃣ Account Creation"]
            VerifyDIAccount["✅ Verify & Set<br/>DI Account Service"]
            CreateAccount["👤 Create Commerce<br/>User Account Service"]
            AddSalesGroups["👥 Add Sales Center<br/>Groups Service"]
        end
        
        %% Organization Setup Phase
        subgraph OrgPhase ["4️⃣ Organization Setup"]
            CreateSalesOrg["🏢 Create User Facility<br/>Sales Org Service"]
            QueueManager["📋 Queue Manager<br/>Sales Org Events"]
            QueueApprovers["🎯 Queue Tier<br/>Approvers Service"]
        end
        
        %% Final Notification Phase
        subgraph NotificationPhase ["5️⃣ Final Notifications"]
            InsightsDecision{"📊 Insights<br/>Required?"}
            DomoNotification["📊 Notify Domo<br/>About User"]
            AdminNotification["👨‍💼 Notify Coke Admin<br/>About User"]
        end
        
        %% End States
        EndSuccess([✅ Success])
        EndFailed([❌ Failed])
        EndPartial([⚠️ Partial])
    end

    %% ========================================
    %% ASYNCHRONOUS PROCESSING
    %% ========================================
    subgraph AsyncWorkflow ["🔄 Asynchronous Processing"]
        direction TB
        
        subgraph SalesOrgAsync ["📈 Sales Organization Processing"]
            AsyncSalesOrg["🔄 Add User to Sales<br/>Center Org (Async)"]
        end
        
        subgraph ManagerHierarchy ["👨‍💼 Manager Hierarchy Processing"]
            ManagerService["👔 Add User to Manager<br/>Sales Org Hierarchy"]
            ManagerDecision{"👨‍💼 Manager Org<br/>Found?"}
            ManagerRetry["🔄 Retry Logic<br/>(Max 10 attempts)"]
        end
        
        subgraph TierApprovals ["🎯 Tier Approval Processing"]
            TierService["🎯 Add Tier Level<br/>Approvers Service"]
            ApprovalDecision{"📋 Approval<br/>Level?"}
            ExemptPath["🆓 Exempt<br/>Processing"]
            ABCPath["📊 A/B/C Level<br/>Processing"]
        end
    end

    %% ========================================
    %% MAIN WORKFLOW CONNECTIONS
    %% ========================================
    Start --> EventRule
    EventRule --> LookupJobTitle
    
    %% Job Title Phase Connections
    LookupJobTitle --> JobTitleTierApprovalsTable
    LookupJobTitle --> CommerceHRUserDataTable
    LookupJobTitle --> JobTitleDecision
    JobTitleDecision -->|"✅ Found"| LookupFacility
    JobTitleDecision -->|"❌ Not Found"| JobTitleError
    JobTitleError --> CHREmailNotificationsTable
    JobTitleError --> EndFailed
    
    %% Facility Phase Connections
    LookupFacility --> FacilitySalesCenterMappingsTable
    LookupFacility --> FacilityDecision
    FacilityDecision -->|"✅ Found"| VerifyDIAccount
    FacilityDecision -->|"❌ Not Found"| FacilityError
    FacilityError --> CHREmailNotificationsTable
    FacilityError --> EndFailed
    
    %% Account Phase Connections
    VerifyDIAccount --> Liferay
    VerifyDIAccount --> CreateAccount
    CreateAccount --> Liferay
    CreateAccount --> CommerceHRUserDataTable
    CreateAccount --> AddSalesGroups
    AddSalesGroups --> Liferay
    AddSalesGroups -->|"✅ Success"| CreateSalesOrg
    AddSalesGroups -->|"❌ Failure"| EndPartial
    
    %% Organization Phase Connections
    CreateSalesOrg --> EventBus
    CreateSalesOrg --> QueueManager
    QueueManager --> CommerceHRUserSalesOrgQueue
    QueueManager --> QueueApprovers
    QueueApprovers --> CommerceHRUserTierApprovalsQueue
    QueueApprovers --> InsightsDecision
    
    %% Notification Phase Connections
    InsightsDecision -->|"✅ Yes"| DomoNotification
    InsightsDecision -->|"❌ No"| AdminNotification
    DomoNotification --> CHREmailNotificationsTable
    DomoNotification --> EndSuccess
    AdminNotification --> CHREmailNotificationsTable
    AdminNotification --> EndSuccess

    %% ========================================
    %% ASYNC WORKFLOW CONNECTIONS
    %% ========================================
    EventBus -->|"📡 Sales Org Event"| AsyncSalesOrg
    AsyncSalesOrg --> Liferay
    AsyncSalesOrg -->|"❌ Failure"| EndPartial
    
    CommerceHRUserSalesOrgQueue --> ManagerService
    ManagerService --> Liferay
    ManagerService --> ManagerDecision
    ManagerDecision -->|"✅ Found"| Liferay
    ManagerDecision -->|"🔄 Retry"| ManagerRetry
    ManagerRetry --> CommerceHRUserSalesOrgQueue
    ManagerDecision -->|"❌ Max Retries"| CHREmailNotificationsTable
    
    CommerceHRUserTierApprovalsQueue --> TierService
    TierService --> ApprovalDecision
    ApprovalDecision -->|"🆓 Exempt"| ExemptPath
    ApprovalDecision -->|"📊 A/B/C"| ABCPath
    ExemptPath --> CHREmailNotificationsTable
    ABCPath --> Liferay
    ABCPath -->|"❌ Failure"| CHREmailNotificationsTable

    %% ========================================
    %% STYLING
    %% ========================================
    classDef startEnd fill:#e1f5fe,stroke:#01579b,stroke-width:3px,color:#000
    classDef process fill:#f3e5f5,stroke:#4a148c,stroke-width:2px,color:#000
    classDef decision fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
    classDef data fill:#e8f5e8,stroke:#1b5e20,stroke-width:2px,color:#000
    classDef external fill:#fce4ec,stroke:#880e4f,stroke-width:2px,color:#000
    classDef error fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#000
    classDef success fill:#e8f5e8,stroke:#2e7d32,stroke-width:3px,color:#000
    
    class Start,EndSuccess,EndFailed,EndPartial startEnd
    class LookupJobTitle,LookupFacility,VerifyDIAccount,CreateAccount,AddSalesGroups,CreateSalesOrg,QueueManager,QueueApprovers,DomoNotification,AdminNotification,AsyncSalesOrg,ManagerService,TierService process
    class JobTitleDecision,FacilityDecision,InsightsDecision,ManagerDecision,ApprovalDecision decision
    class JobTitleTierApprovalsTable,CommerceHRUserDataTable,FacilitySalesCenterMappingsTable,CHREmailNotificationsTable,CommerceHRUserSalesOrgQueue,CommerceHRUserTierApprovalsQueue data
    class Liferay,Domo,EmailSystem external
    class JobTitleError,FacilityError error
    class EventBus,EventRule success